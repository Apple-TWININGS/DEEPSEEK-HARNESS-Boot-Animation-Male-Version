    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "boot-animation",
    "splash",
    "wallpaper",
    "background",
    "appearance",
    "ui",
    "cordis",
    "plugin"
  ],
  "license": "MIT",
  "author": "Apple-TWININGS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Apple-TWININGS/DEEPSEEK-HARNESS-Boot-Animation-Male-Version.git"
  },
  "homepage": "https://github.com/Apple-TWININGS/DEEPSEEK-HARNESS-Boot-Animation-Male-Version#readme",
  "bugs": {
    "url": "https://github.com/Apple-TWININGS/DEEPSEEK-HARNESS-Boot-Animation-Male-Version/issues"
